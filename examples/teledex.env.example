# Teledex configuration
# Copy to a private file, replace placeholders, then run:
#   npm run doctor -- --env-file teledex.env
#   npm start -- --env-file teledex.env

# Required Telegram settings.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_USER_IDS=replace-me
TELEGRAM_FORUM_CHAT_ID=replace-me

# Explicit supported backend selection. Omitting both lines uses the same
# app-server-v2 default; when TELEDEX_BACKEND is explicit, keep the enable flag.
TELEDEX_BACKEND=app-server-v2
TELEDEX_ENABLE_APP_SERVER_V2=1

# Recommended isolation boundaries. Create both paths before the first run.
# Defaults are documented in docs/config.md.
TELEDEX_WORKSPACE_ROOT=../teledex-workspace
TELEDEX_STATE_ROOT=../teledex-state

# Optional executable and runtime settings.
CODEX_BIN_PATH=codex
CODEX_MODEL=
CODEX_REASONING_EFFORT=
TELEDEX_MCP_PRESET=none
